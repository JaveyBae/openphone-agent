# OpenAI-compatible local inference endpoint (Ollama default shown).
AGENT_BASE_URL=http://127.0.0.1:11434/v1
AGENT_MODEL=your-vision-model

# Leave empty for local Ollama/llama.cpp when authentication is disabled.
AGENT_API_KEY=

# Use "mock" for a no-model smoke test or "openai" for a real model.
AGENT_PROVIDER=mock
